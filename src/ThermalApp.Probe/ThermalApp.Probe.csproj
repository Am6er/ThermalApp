<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>ThermalApp.Probe</RootNamespace>
    <AssemblyName>ThermalApp.Probe</AssemblyName>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibUsbDotNet" Version="3.0.224" />
    <PackageReference Include="OpenCvSharp4.Windows" Version="4.13.0.20260627" />
  </ItemGroup>

  <!-- переиспользуем код приложения без ссылки на WPF-проект -->
  <ItemGroup>
    <Compile Include="..\ThermalApp\Core\*.cs" LinkBase="Core" />
    <Compile Include="..\ThermalApp\Device\*.cs" LinkBase="Device" />
    <Compile Include="..\ThermalApp\Recording\RadiometryFile.cs" LinkBase="Recording" />
  </ItemGroup>

</Project>
